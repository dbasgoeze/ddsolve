// wlp == 9116609742327046129369475835097193051812475059557626463974391/401734511064747568885490523085290650630550748445698208825344
const bound = 25;
const a_bound = bound;
const b_bound = bound;
s = 1;
a = 0;
b = 0;

@unroll(200)
while (s == 1) {
    {a = a + 1}[1/2]{b = b + 1}
    {}[1/2]{
        if (!(a < a_bound & b < b_bound)) {
            s = 0
        }
    }
}
// a
